if {TokenQuestStatus} == 0:
	fan_of_four: 来てる！ [speed=3.5][color=orange][wave]ギャング・オブ・フォー[/wave][/color]が[speed=1.0]来てるんだ！ 最高だよ！！！
	fan_of_four: めちゃくちゃカッコいいんだ！ 好きなときに[color=orange][wave]タイムトラベル[/wave][/color]できるし、この宇宙を[color=orange][wave]6回[/wave][/color]も救ってるんだ！ [color=red]ワルダー・アクヤック[/color]も、[color=red]戦車のフランク[/color]も、[color=red]スティーブ[/color]も、[color=orange][wave]先週の金曜日[/wave][/color]にやっつけたんだよ！
	fan_of_four: サインのためなら[color=orange][wave]なんだって[/wave][/color]差し出すのに、緊張しすぎて話しかけられないよ！ うわあああ！！！
	set {TokenQuestStatus} = 1
elif {TokenQuestStatus} < 3:
	if {TokenCount} >= 4:
		fan_of_four: これを、ぼくに……？
		fan_of_four: ……
		fan_of_four: 人生で最高の日だ！！！
		fan_of_four: どうお礼をしたらいいんだろう？ そうだ、この杖をあげるよ。あのヘンなおばあさんから[b]借りてきた[/b]やつなんだ。
		[signal arg="GiveWand"]
		set {TokenQuestStatus} = 3
	else:
		fan_of_four: こ、興奮してる？ ぼくが？ なんでそう思うのさ？
		# Bump the quest status up by one so that the interaction knows that this is not the first encounter witht the NPC.
		set {TokenQuestStatus} = 2
else:
	fan_of_four: 人生で最高の日だ！！！
[end_timeline]
